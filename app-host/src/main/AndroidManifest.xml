<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 宿主必须具备 USB Host / OTG 能力（计划 0.6） -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!--
          选择页 = 唯一入口。

          ★ 插线过滤器为什么挂在这里、而不是 HostActivity：
            iPad 也有 bulk 端点对（if2 的 0x86/0x05），挂在 AOA 页会让平板一插上
            就去走 AOA 握手。本页只读设备描述符做分类：能确定类型就直接跳对应页面，
            不确定就停在这里让用户点。
          计划 2.1 / 0.7：exported 必须显式（带 intent-filter 在 API 31+ 否则装不上）；
          launchMode=singleTask + onNewIntent：插线复用同一实例，不叠 Activity。
        -->
        <activity
            android:name=".ChooserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- 插线即达：用【空匹配】过滤器，覆盖手机「仅充电、无 MTP 接口」的场景（计划 2.1） -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AOA 投屏页：行为与合并前完全一致（exported + singleTask + 同一套 configChanges）。
          仍然 exported：部分 ROM 在配件模式下会按 intent 直接拉起该页。
        -->
        <activity
            android:name=".HostActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask" />

        <!--
          iPad / iPhone 投屏页（QuickTime USB）。
          configChanges 必须带 orientation|screenSize：iPad 转屏会改变编码分辨率，
          Activity 重建会把 USB 会话连根拔掉（面板/药丸状态也会丢）。
        -->
        <activity
            android:name=".ios.IosActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask" />
    </application>

</manifest>
