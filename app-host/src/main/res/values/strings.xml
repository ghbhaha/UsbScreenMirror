<?xml version="1.0" encoding="utf-8"?>
<!--
  默认界面文案 = 简体中文。

  为什么默认用中文而不是英文：本项目从文档到**运行时状态文本**（HostActivity 里
  onStatus 传的那些字符串）本来就是中文，只有布局里的静态文案曾是英文，
  结果界面上是「中文状态 + 英文按钮」的混搭。默认统一成中文即可消除这种不一致，
  也让中文设备无需任何额外配置。

  英文用户由 values-en/ 覆盖（系统按语言自动选择），两边键名必须一一对应。

  app_name 是**桌面显示名**：中文用「投屏接收」/「投屏发送」，英文用 Cast In / Cast Out
  （cast = 投屏的通用词，In/Out 表方向且与图标箭头一致）。
  ⚠️ 名字要短：桌面格子窄，实测 6 个字符就会被截断（旧名 UAV Host 在平板上显示成 "UAV Hos…"）。
-->
<resources>
    <string name="app_name">投屏接收</string>

    <!-- 面板标题栏 -->
    <string name="host_title">USB 投屏</string>
    <string name="host_btn_collapse">收起面板</string>

    <!-- 常驻状态药丸（短词，显示在画面左上角） -->
    <string name="host_chip_idle">空闲</string>
    <string name="host_chip_connecting">连接中</string>
    <string name="host_chip_mirroring">投屏中</string>
    <string name="host_chip_renegotiating">重协商</string>
    <string name="host_chip_replay">回放</string>
    <string name="host_chip_no_signal">无输出</string>
    <string name="host_chip_error">出错</string>
    <string name="host_chip_peer_app_missing">缺 App</string>

    <!-- 状态行 -->
    <string name="host_status_idle">空闲中 —— 请把配件手机插上来</string>
    <!--
      主状态行只说"处于哪个阶段"（10.23）。它**不能**包含任何"正在等你…"式的进度语义 ——
      进度文本归副行。原先两者共用一行，导致原地重协商时画面没断却被说成"等待视频流"。
    -->
    <string name="host_status_connecting">正在建立连接…</string>
    <string name="host_status_mirroring">投屏中</string>
    <string name="host_status_renegotiating">投屏中 · 正在重协商…</string>
    <string name="host_status_replay">回放抓流中</string>
    <!-- ERROR 阶段的主行只说"出错了"，具体原因在副行（onError 已把原因拼进去） -->
    <string name="host_status_no_signal">手机无输出</string>
    <string name="host_status_error">链路出错</string>
    <string name="host_status_peer_app_missing">对方设备无应答</string>
    <!-- 副行说明：说清"为什么"和"去哪装"，不要只写"连接失败" -->
    <string name="host_detail_peer_app_missing">已切进配件模式，但对端一直没有任何应答 —— 通常是没装配套 App（装过但被强制停止也会这样）。装好后点「扫描 / 重试」，或拔插一次即可。</string>

    <!-- 操作（磁贴：图标在上、文字在下，文案尽量短） -->
    <string name="host_btn_scan">扫描 / 重试</string>
    <string name="host_btn_force">强制重握手</string>
    <string name="host_btn_replay">回放抓流</string>
    <string name="host_btn_get_app">获取配套 App</string>
    <!-- 下载地址：与 AOA SEND_STRING[4]（AccessoryIdentity.URI）保持一致，指向 Releases 最新版 -->
    <string name="host_app_url" translatable="false">https://github.com/ghbhaha/UsbScreenMirror/releases/latest</string>
    <string name="host_link_copied">本机没有浏览器，下载链接已复制到剪贴板</string>

    <!-- 画质分段控件 -->
    <string name="host_section_quality">画质</string>
    <string name="host_seg_11">1:1 像素</string>
    <string name="host_seg_hd">高清</string>
    <string name="host_quality_note">1:1 按宿主显示区编码（省算力）；高清按面板长边编码、由宿主端缩放，观感更锐。</string>

    <!-- 统计卡片标题 -->
    <string name="host_section_link">链路状态</string>

    <!-- 切换画质时的细节行（10.23 起只进副行，主行已由阶段显示"正在重协商…"） -->
    <string name="host_status_switch_11">已切到 1:1 像素模式（按显示区编码）</string>
    <string name="host_status_switch_hd">已切到高清模式（按面板长边编码）</string>

    <!--
      底部提示：面板会在首帧到达时自动收起，得让用户知道怎么叫回来；
      "自动旋转"是已支持功能（计划 10.7）的前提条件，写出来避免"转不动"被当成 bug。
    -->
    <string name="host_hint">点画面外的空白处显示 / 隐藏此面板 · 手机上需开启自动旋转</string>
