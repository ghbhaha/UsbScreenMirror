<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS 采集端界面（视觉与结构参照 app-host 的 activity_host.xml）。

  分层顺序即叠放顺序：
    1. `surface`    —— 视频。按视频宽高比自适应（AspectRatioSurfaceView，信箱适配）
    2. `status_chip` —— 常驻状态药丸（左上角）。面板收起后仍能看到链路状态，
                        同时它也是"再次打开面板"的显式入口。
    3. `overlay`    —— 控制面板，贴左侧竖栏（首帧到达自动收起）。

  ★ 与 app-host 的**一处必要差异**：那边镜像的是手机竖屏，视频只占中间一条、两侧是宽信箱边，
    侧栏正好落在黑边里；而 iPad 主屏是横屏，视频会铺满，所以这边的面板**一定会压住画面**——
    因此默认展开（首次要配对/看日志），**首帧一到就自动收起**，靠药丸叫回来。

  ⚠️ 除 `surface` 外不要加不透明且铺满的背景，否则会盖住画面。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/host_bg">

    <com.uav.host.aoa.capture.video.AspectRatioSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 常驻状态药丸：链路状态 + 重新打开面板的入口 -->
    <LinearLayout
        android:id="@+id/status_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp">

        <View
            android:id="@+id/chip_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot"
            android:backgroundTint="@color/host_idle" />

        <TextView
            android:id="@+id/chip_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/host_chip_idle"
            android:textColor="@color/host_text"
            android:textSize="12sp" />

        <!-- 细箭头：明确告诉用户"这个药丸可以点开" -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/ios_btn_expand"
            android:rotation="180"
            android:src="@drawable/ic_arrow_left"
            android:tint="@color/host_text_faint" />
    </LinearLayout>

    <!-- 控制面板：左侧竖栏 -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- 标题栏：强调竖条 + 标题 + 收起 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="@drawable/accent_bar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/ios_title"
                android:textColor="@color/host_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_collapse"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:contentDescription="@string/host_btn_collapse"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/host_text_dim" />
        </LinearLayout>

        <!-- 主行只说阶段；进度/原因进副行（照抄 app-host 10.23 的教训） -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/ios_status_idle"
            android:textColor="@color/host_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/host_text_faint"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 设备信息卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.10"
                android:text="@string/ios_section_device"
                android:textColor="@color/host_text_faint"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/host_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!--
          操作：只留一个「重新唤醒」。

          开始/停止与配对都已自动化（插上即配对、即投屏；拔线即停），
          人工只需要一个兜底入口：设备侧 QT 没被武装、一个字节都不来时用它。
          长按它可回放已录制的 feed.bin（离线验证"解析→解码→上屏"）。
        -->
        <Button
            android:id="@+id/btn_rearm"
            style="@style/HostTileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/ic_refresh"
            android:text="@string/ios_btn_rearm" />

        <!--
          停止投屏：以前只能靠"返回键或拔线"结束，而返回键那条路当时是断的
          （Activity 已销毁但读循环收不到停止信号 ⇒ 后台继续无限收流）。
          这个按钮是用户唯一能明确表达"我要停"的入口。
          ★ 它只置停止信号：真正的收尾（发 HPA0/HPD0 → 放接口 → 还配置）在
            capture() 的 finally 里做，不在这里抢。
        -->
        <Button
            android:id="@+id/btn_stop"
            style="@style/HostTileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_close"
            android:text="@string/ios_btn_stop" />

        <!-- 日志卡片：吃掉剩余高度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.10"
                android:text="@string/ios_section_log"
                android:textColor="@color/host_text_faint"
                android:textSize="10sp" />

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:focusable="false"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/host_text_dim"
                    android:focusable="false"
                    android:textSize="10sp" />
            </ScrollView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/host_card_stroke" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/ios_hint"
            android:textColor="@color/host_text_faint"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
