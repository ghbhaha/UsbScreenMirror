<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS（QuickTime USB）采集端文案。

  风格与 `app-host` 保持一致：短标题、状态药丸用两三个字、按钮说"做什么"而不是"叫什么功能"。
-->
<resources>
    <string name="app_name">iOS 投屏</string>

    <!-- 面板标题栏 -->
    <string name="ios_title">iOS 投屏</string>
    <string name="ios_btn_collapse">收起面板</string>
    <string name="ios_btn_expand">展开面板</string>

    <!-- 常驻状态药丸（左上角，越短越好） -->
    <string name="ios_chip_idle">空闲</string>
    <string name="ios_chip_pairing">配对中</string>
    <string name="ios_chip_connecting">连接中</string>
    <string name="ios_chip_mirroring">投屏中</string>
    <string name="ios_chip_rearm">唤醒中</string>
    <string name="ios_chip_replay">回放</string>
    <string name="ios_chip_error">出错</string>

    <!-- 主状态行：只说"当前处于哪个阶段"，进度细节一律进副行 -->
    <string name="ios_status_idle">空闲中 —— 把 iPad 用数据线插到本机</string>
    <string name="ios_status_unpaired">这台 iPad 还没被本机信任</string>
    <string name="ios_status_pairing">等待你在 iPad 上点「信任」…</string>
    <string name="ios_status_connecting">正在建立连接…</string>
    <string name="ios_status_mirroring">投屏中</string>
    <string name="ios_status_rearm">正在唤醒 iPad 的采集通道…</string>
    <string name="ios_status_replay">回放录制流</string>
    <string name="ios_status_error">链路出错</string>

    <!-- 操作（侧栏磁贴行：图标在左、文字在右） -->
    <string name="ios_btn_start">开始投屏</string>
    <string name="ios_btn_stop">停止投屏</string>
    <string name="ios_btn_pair">配对（信任本机）</string>
    <string name="ios_btn_rearm">重新唤醒采集通道</string>

    <!-- 卡片标题 -->
    <string name="ios_section_device">设备</string>
    <string name="ios_section_log">运行日志</string>

    <!-- 副行提示 -->
    <string name="ios_detail_no_device">未检测到 Apple 设备（VID 0x05AC）</string>
    <string name="ios_detail_pair_hint">配对成功后本机即成为受信任主机，以后不用再点</string>
    <string name="ios_detail_rearm_hint">配对完成后第一次投屏、或长时间无数据时才需要</string>

    <string name="ios_hint">点画面空白处或左上角药丸可显示 / 隐藏此面板 · 长按「开始投屏」回放上次录制的流</string>
</resources>
