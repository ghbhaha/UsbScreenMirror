<?xml version="1.0" encoding="utf-8"?>
<!-- 操作磁贴背景（带按下反馈） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_tile_pressed" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/ios_tile_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_tile" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/ios_tile_stroke" />
        </shape>
    </item>
</selector>
