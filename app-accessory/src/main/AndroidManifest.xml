<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      手机端（配件侧）不需要 usb.host feature，也不需要任何 USB 权限：
      配件模式下的 USB 访问权由 intent 附带的 fd 授予（计划 3.2）。
    -->

    <!-- 采集必须跑在前台服务里（计划 3.5）；API 34+ 要求 mediaProjection 类型 + 对应权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      音频内录（计划 10.13）需要两样东西，缺一不可：

      1. RECORD_AUDIO —— 运行时权限，内录（AudioPlaybackCapture）硬性要求；
      2. microphone 前台服务类型 + 对应权限 —— ★ 这一条最容易漏。

         AOSP 的 ForegroundServiceTypePolicy 里，`mediaProjection` 类型的运行时前提
         只有 CAPTURE_VIDEO_OUTPUT + OP_PROJECT_MEDIA，**不含 RECORD_AUDIO**；
         而 RECORD_AUDIO 属于「使用时权限」，应用在后台时只有当前台服务带了
         **覆盖该权限的类型**（即 microphone）才放行。
         漏掉它的后果不是报错，而是**录到全 0** —— 最难查的那种失败。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ProjectionActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- 被宿主切换到配件模式后，系统据此拉起本 App（计划 3.1） -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ★ 顺序敏感：Android 14+ 必须先以 mediaProjection 类型进入前台，
            之后才允许 getMediaProjection()（见 CaptureService 的启动顺序注释）

          microphone 类型是为音频内录准备的；运行时会按"宿主是否要音频 + 是否已授权"决定
          实际传哪些类型（见 CaptureService.canDeclareMicrophoneType）。
        -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>

</manifest>
